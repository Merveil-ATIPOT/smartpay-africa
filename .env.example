# SmartPay Africa — variables d'environnement LOCALES uniquement.
# Copier vers .env et remplacer les valeurs. Ne jamais commiter .env.
# Aucun secret Lightning, macaroon, seed ou clé privée ne doit être collé ici.

# --- Django ---
DJANGO_SETTINGS_MODULE=config.settings.development
DJANGO_SECRET_KEY=change-me-in-local-development-only
DJANGO_DEBUG=true
# 10.0.2.2 = émulateur Android. Ajouter l'IP LAN pour un téléphone physique.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,api,10.0.2.2
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- Base de données (Docker Compose ou PostgreSQL local) ---
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=smartpay
POSTGRES_USER=smartpay
POSTGRES_PASSWORD=change-me-local-only

# Pour un PostgreSQL local hors Docker, utiliser par exemple :
# POSTGRES_HOST=127.0.0.1
# POSTGRES_PORT=5432

# --- Auth JWT ---
JWT_SIGNING_KEY=change-me-jwt-local-only
JWT_ACCESS_MINUTES=30
JWT_REFRESH_DAYS=7
# Quota d'inscription publique par IP (ScopedRateThrottle register)
AUTH_REGISTER_THROTTLE=5/hour

# --- Fournisseur de paiement ---
# mock = accusé simulé, jamais Lightning settled.
# lnd_regtest = laboratoire P04 (overlay compose.regtest.yaml côté Docker).
PAYMENT_PROVIDER=mock
BITCOIN_NETWORK=regtest

# LND Regtest — chemins FICHIERS uniquement, jamais le contenu d'un macaroon.
# Hôte : REST Alice 127.0.0.1:8081. Docker P04 : overlay force https://lnd-alice:8080
# et monte les secrets en lecture seule sous /run/lnd/.
LND_REST_URL=https://127.0.0.1:8081
LND_MACAROON_PATH=infrastructure/lightning-regtest/secrets/alice/admin.macaroon
LND_TLS_CERT_PATH=infrastructure/lightning-regtest/secrets/alice/tls.cert
LND_TIMEOUT_SECONDS=45

# Bob = contrepartie laboratoire, pas le portefeuille utilisateur.
# LND_BOB_REST_URL=https://127.0.0.1:8082
# LND_BOB_MACAROON_PATH=infrastructure/lightning-regtest/secrets/bob/admin.macaroon
# LND_BOB_TLS_CERT_PATH=infrastructure/lightning-regtest/secrets/bob/tls.cert
# LAB_COUNTERPARTY_ENABLED=false

# RPC Bitcoin du laboratoire (réseau Docker interne uniquement)
BITCOIN_RPC_USER=smartpayregtest
BITCOIN_RPC_PASSWORD=changeme-regtest-rpc-only
LND_WALLET_PASSWORD=changeme-regtest-wallet

# --- Comptes de développement (seed) ---
DEV_ADMIN_EMAIL=admin@smartpay.local
DEV_ADMIN_PASSWORD=changeme-local-only
DEV_USER_EMAIL=user@smartpay.local
DEV_USER_PASSWORD=changeme-local-only

# --- Clients ---
NEXT_PUBLIC_API_URL=http://localhost:8000
# Mobile Expo (surcharge possible dans l'écran Profil) :
# - Simulateur iOS : http://127.0.0.1:8000
# - Émulateur Android : http://10.0.2.2:8000
# - Téléphone physique : http://IP_LAN:8000 (API doit écouter 0.0.0.0:8000)
EXPO_PUBLIC_API_URL=http://127.0.0.1:8000
# Téléphone physique : http://IP_LAN:8000 (l'app réécrit localhost vers l'hôte Metro)
